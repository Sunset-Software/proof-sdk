# Proof SDK configuration.
#
# Copy this file to `.env` and edit the values. `npm run serve` loads it
# automatically via `tsx --env-file-if-exists=.env`. `.env` is gitignored.
#
# All variables are optional — the server runs on localhost:4000 with no
# configuration — but each section below covers a deployment shape
# you're likely to hit.

# -----------------------------------------------------------------------
# Vite client build
# -----------------------------------------------------------------------

# Optional telemetry toggle.
VITE_ENABLE_TELEMETRY=false

# Optional app version tag for event properties
VITE_APP_VERSION=dev

# -----------------------------------------------------------------------
# Server basics
# -----------------------------------------------------------------------

# HTTP port. The editor, agent API, and WebSocket share this port.
# PORT=4000

# -----------------------------------------------------------------------
# Public origin (required for any non-localhost deployment)
# -----------------------------------------------------------------------

# The canonical URL the browser uses to reach this server. Used to build
# share links (e.g. POST /documents `shareUrl` field) and — critically —
# the collab WebSocket URL. When your page is served over HTTPS, this
# MUST be the https:// origin so the WS URL is built as wss://.
#
# Tailscale serve example:
#   PROOF_PUBLIC_BASE_URL=https://treys-mbp.tail0dea1c.ts.net
#
# Leave unset for pure localhost development.
# PROOF_PUBLIC_BASE_URL=https://your-host.example.com

# Alternative to the above: trust x-forwarded-proto / x-forwarded-host
# headers from an upstream proxy (Tailscale serve, nginx, Cloudflare, etc.)
# and derive the public URL per request. Useful when multiple origins
# front the same server.
# PROOF_TRUST_PROXY_HEADERS=1

# CORS allow-list (comma-separated). Only matters if another origin will
# do XHRs against this server. Default allows localhost:3000/4000.
# PROOF_CORS_ALLOW_ORIGINS=https://your-host.example.com

# -----------------------------------------------------------------------
# Collab runtime
# -----------------------------------------------------------------------

# Long random string used to sign collab session JWTs. When the collab
# WebSocket is exposed on any host other than loopback, this is
# REQUIRED — the server refuses to start the collab runtime without it.
# Keep the same value across restarts; changing it invalidates any
# in-flight session tokens.
#
#   Generate with: openssl rand -hex 32
#
# For pure localhost development you can leave this unset; the server
# will fall back to an ephemeral in-memory key.
# PROOF_COLLAB_SIGNING_SECRET=

# Disable the collab runtime entirely (falls back to snapshot-only mode).
# PROOF_COLLAB_V2=0

# Override the WS URL the server hands to clients. Usually you don't
# need this — PROOF_PUBLIC_BASE_URL is enough.
# COLLAB_PUBLIC_BASE_URL=wss://your-host.example.com/ws

# When 1, the request-scoped WS URL resolver assumes the collab WS is
# multiplexed on the same HTTP port (embedded topology). This OSS build
# defaults to embedded; set explicitly if you deploy with a separate
# collab process.
# COLLAB_EMBEDDED_WS=1

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

# Path to the SQLite file. Defaults to proof-share.db in the cwd.
# DATABASE_PATH=./proof-share.db
